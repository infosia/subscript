+
+pub(crate) fn find_budgeted(
+    re: &CompiledRegex,
+    text: &str,
+    budget: u64,
+) -> Result<Option<Match>, crate::api::BudgetExhausted> {
+    let input = Utf8Input::new(text, re.flags.unicode);
+    let matcher = MatchAttempter::new_budgeted(re, input.left_end(), budget);
+    let mut executor = BacktrackExecutor { input, matcher };
+    let mut next_start = exec::MatchProducer::initial_position(&executor, 0);
+    let result = next_start
+        .and_then(|pos| exec::MatchProducer::next_match(&mut executor, pos, &mut next_start));
+    if executor.matcher.budget.exhausted {
+        Err(crate::api::BudgetExhausted)
+    } else {
+        Ok(result)
+    }
+}

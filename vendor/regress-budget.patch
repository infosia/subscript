@@ -2099,3 +2099,30 @@ fn test_non_greedy_quantifiers_tc(tc: TestConfig) {
     // Test zero-width non-greedy match
     tc.compile(r"a.*?a").match1f("aa").test_eq("aa");
 }
+
+#[test]
+fn budgeted_find_distinguishes_exhaustion_from_no_match() {
+    let re = regress::Regex::new("needle").unwrap();
+    assert!(matches!(
+        re.find_budgeted("a needle here", 100),
+        Ok(Some(m)) if m.range() == (2..8)
+    ));
+    assert!(matches!(re.find_budgeted("haystack", 100), Ok(None)));
+    assert!(matches!(
+        re.find_budgeted("a needle here", 0),
+        Err(regress::BudgetExhausted)
+    ));
+
+    let re = regress::Regex::new(r"(a+)+$").unwrap();
+    let text = format!("{}!", "a".repeat(64 * 1024));
+    assert!(matches!(
+        re.find_budgeted(&text, 1000),
+        Err(regress::BudgetExhausted)
+    ));
+
+    let re = regress::Regex::new(r".*.*.*.*b").unwrap();
+    assert!(matches!(
+        re.find_budgeted(&"a".repeat(64 * 1024), 1000),
+        Err(regress::BudgetExhausted)
+    ));
+}
